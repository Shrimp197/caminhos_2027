{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APOI V1 Dataset",
  "type": "object",
  "required": ["dataset_version", "environment", "apoi"],
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1},
    "environment": {"enum": ["production", "sr", "hf"]},
    "apoi": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "main_category", "services", "location", "publication"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "main_category": {"enum": ["alimentacao", "agua", "descanso", "pernoita", "duches", "carregamento", "transporte", "emergencia"]},
          "services": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "location": {
            "type": "object",
            "required": ["precision", "route_relation"],
            "properties": {
              "latitude": {"type": "number", "minimum": -90, "maximum": 90},
              "longitude": {"type": "number", "minimum": -180, "maximum": 180},
              "precision": {"enum": ["exact", "approximate", "locality_only", "unknown"]},
              "locality": {"type": "string"},
              "municipality": {"type": "string"},
              "reference": {"type": "string"},
              "route_id": {"type": "string"},
              "route_km": {"type": "number", "minimum": 0},
              "distance_to_route_m": {"type": "number", "minimum": 0},
              "access_distance_m": {"type": "number", "minimum": 0},
              "route_relation": {"enum": ["on_route", "near_route", "accessible_with_detour", "distant_potential_support", "location_uncertain", "outside_route"]}
            },
            "additionalProperties": false
          },
          "publication": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["candidate", "review", "published", "published_with_warning", "historical", "closed", "excluded"]},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
